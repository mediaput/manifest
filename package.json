{
  "name": "@mediaput/manifest",
  "version": "1.0.0",
  "description": "Manifest validator for Mediaput plugins.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node scripts/copy.js",
    "build:types": "tsc --emitDeclarationOnly --outDir dist/types"
  },
  "keywords": [
    "Mediaput",
    "manifest",
    "validator",
    "schema",
    "json-schema",
    "Mediaput Plugin",
    "ajv"
  ],
  "author": "SparkHo",
  "license": "MIT",
  "engines": {
    "node": ">=16"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "tsup": "^8.5.1",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.1"
  }
}